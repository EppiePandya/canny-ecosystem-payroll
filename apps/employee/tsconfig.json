{
  "extends": "@canny_ecosystem/typescript/remix.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/*"]
    },
    "strict": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "tailwind.config.ts",
    "types/index.d.ts",
    "index.js",
    "server/dev-server.js"
  ],
  "exclude": ["node_modules"]
}
